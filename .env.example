# ── Base de datos (PostgreSQL 14+) ──
DATABASE_URL=postgres://vance:vance@localhost:5432/vance
# Solo para pruebas de integración (se vacía en cada ejecución)
TEST_DATABASE_URL=postgres://vance:vance@localhost:5432/vance_test

# ── Aplicación ──
APP_URL=http://localhost:3000
# Directorio privado donde se guardan los archivos subidos (fuera de /public)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_PAGES_PER_DOCUMENT=400

# ── Inteligencia artificial (Anthropic Claude) ──
# Sin clave, la plataforma funciona pero el análisis, la verificación, la generación de
# actividades abiertas y la evaluación semántica quedan en estado "IA no disponible".
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Presupuesto diario de tokens por usuario (control de costes). 0 = sin límite.
AI_DAILY_TOKEN_BUDGET_PER_USER=2000000
# Contrastar afirmaciones con búsqueda web (herramienta web_search de Anthropic, tiene coste por búsqueda)
VERIFY_WITH_WEB_SEARCH=true
# Contrastar afirmaciones biomédicas con PubMed (NCBI E-utilities, gratuito)
VERIFY_WITH_PUBMED=true
# Opcional: clave de NCBI para aumentar el límite de peticiones a PubMed
NCBI_API_KEY=
NCBI_CONTACT_EMAIL=

# ── Correo (recuperación de contraseña) ──
# Si no se configura SMTP, el enlace de recuperación se escribe en el log del servidor (solo desarrollo).
SMTP_URL=
MAIL_FROM="VANCE <no-reply@example.com>"

# ── Trabajos en segundo plano ──
# true: el servidor web también procesa la cola (cómodo en desarrollo).
# En producción se recomienda false y ejecutar `npm run worker` como proceso aparte.
RUN_WORKER_IN_WEB=true
WORKER_CONCURRENCY=2
